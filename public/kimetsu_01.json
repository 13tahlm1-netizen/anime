[
  {
    "start": 35.317,
    "end": 39.952,
    "text": "어째서..."
  },
  {
    "start": 39.952,
    "end": 44.688,
    "text": "어쩌다 이렇게 된 거지...?"
  },
  {
    "start": 44.688,
    "end": 46.218,
    "text": "네즈코, 죽지 마!"
  },
  {
    "start": 46.218,
    "end": 49.464,
    "text": "죽으면 안 돼!"
  },
  {
    "start": 49.464,
    "end": 53.696,
    "text": "반드시 구해줄 테니까...!"
  },
  {
    "start": 53.696,
    "end": 56.441,
    "text": "죽게 놔둘까 보냐..."
  },
  {
    "start": 56.441,
    "end": 58.872,
    "text": "오빠가 꼭...!"
  },
  {
    "start": 58.872,
    "end": 73.076,
    "text": "살려줄 테니까!!"
  },
  {
    "start": 73.076,
    "end": 77.59700000000001,
    "text": "탄지로"
  },
  {
    "start": 77.59700000000001,
    "end": 80.136,
    "text": "얼굴이 새까맣잖니"
  },
  {
    "start": 80.136,
    "end": 84.128,
    "text": "이리 오렴"
  },
  {
    "start": 84.128,
    "end": 88.736,
    "text": "눈이 내려서 위험하니까<br>굳이 갈 필요는 없단다"
  },
  {
    "start": 88.736,
    "end": 93.576,
    "text": "설날이 되면<br>모두 배불리 먹여주고 싶으니까"
  },
  {
    "start": 93.576,
    "end": 96.72800000000001,
    "text": "조금이라도<br>숯을 팔고 올게"
  },
  {
    "start": 96.72800000000001,
    "end": 99.8,
    "text": "고맙구나..."
  },
  {
    "start": 99.8,
    "end": 102.737,
    "text": "형!"
  },
  {
    "start": 102.737,
    "end": 104.768,
    "text": "오늘도 마을에 내려가는 거야?"
  },
  {
    "start": 104.768,
    "end": 108.136,
    "text": "나도 갈래!"
  },
  {
    "start": 108.136,
    "end": 109.58,
    "text": "그러면 안 되지"
  },
  {
    "start": 109.58,
    "end": 112.532,
    "text": "탄지로처럼<br>빨리 걷지도 못하잖니?"
  },
  {
    "start": 112.532,
    "end": 114.205,
    "text": "엄마~"
  },
  {
    "start": 114.205,
    "end": 115.525,
    "text": "안 돼!"
  },
  {
    "start": 115.525,
    "end": 118.34100000000001,
    "text": "오늘은<br>짐차도 끌고 갈 수 없으니까"
  },
  {
    "start": 118.34100000000001,
    "end": 123.565,
    "text": "태워달라고 해서<br>쉬고 그럴 수도 없다구?"
  },
  {
    "start": 123.565,
    "end": 126.42,
    "text": "형아~!"
  },
  {
    "start": 126.42,
    "end": 128.685,
    "text": "따라가고 싶어!"
  },
  {
    "start": 128.685,
    "end": 131.582,
    "text": "제대로 도와줄게!"
  },
  {
    "start": 131.582,
    "end": 133.853,
    "text": "고마워, 하나코"
  },
  {
    "start": 133.853,
    "end": 139.701,
    "text": "그래도 오늘은 집 보고 있자?"
  },
  {
    "start": 139.701,
    "end": 140.901,
    "text": "시게루도"
  },
  {
    "start": 140.901,
    "end": 144.076,
    "text": "그 대신,<br>맛난 거 잔뜩 사올 테니까!"
  },
  {
    "start": 144.076,
    "end": 145.349,
    "text": "정말?"
  },
  {
    "start": 145.349,
    "end": 148.038,
    "text": "그럼!"
  },
  {
    "start": 148.038,
    "end": 151.245,
    "text": "하나코도 돌아오면<br>책 읽어줄게?"
  },
  {
    "start": 151.245,
    "end": 152.422,
    "text": "응!"
  },
  {
    "start": 152.422,
    "end": 153.74,
    "text": "착하다"
  },
  {
    "start": 153.74,
    "end": 155.925,
    "text": "고맙구나, 탄지로"
  },
  {
    "start": 155.925,
    "end": 157.22899999999998,
    "text": "응"
  },
  {
    "start": 157.22899999999998,
    "end": 159.277,
    "text": "그럼, 다녀올게"
  },
  {
    "start": 159.277,
    "end": 160.461,
    "text": "타케오"
  },
  {
    "start": 160.461,
    "end": 162.564,
    "text": "할 수 있는만큼만<br>해도 되니까"
  },
  {
    "start": 162.564,
    "end": 164.845,
    "text": "조금만 장작을 패줄래?"
  },
  {
    "start": 164.845,
    "end": 168.012,
    "text": "그야 하긴 하겠지만 말야..."
  },
  {
    "start": 168.012,
    "end": 172.90800000000002,
    "text": "같이 할 줄 알았는데~"
  },
  {
    "start": 172.90800000000002,
    "end": 174.09300000000002,
    "text": "옳지, 옳지~"
  },
  {
    "start": 174.09300000000002,
    "end": 175.613,
    "text": "뭐야, 갑자기!"
  },
  {
    "start": 175.613,
    "end": 177.477,
    "text": "타케 형, 쑥스러워 한대요!"
  },
  {
    "start": 177.477,
    "end": 178.74099999999999,
    "text": "시끄러워, 짜샤!"
  },
  {
    "start": 178.74099999999999,
    "end": 180.037,
    "text": "옳지, 옳지~"
  },
  {
    "start": 180.037,
    "end": 186.965,
    "text": "그러니까 하지 말라고!"
  },
  {
    "start": 186.965,
    "end": 189.78,
    "text": "얼른 돌아와야 해~"
  },
  {
    "start": 189.78,
    "end": 196.893,
    "text": "조심하구!"
  },
  {
    "start": 196.893,
    "end": 199.348,
    "text": "오빠!"
  },
  {
    "start": 199.348,
    "end": 200.725,
    "text": "네즈코"
  },
  {
    "start": 200.725,
    "end": 203.63,
    "text": "로쿠타를 어르면서<br>재우고 있었거든"
  },
  {
    "start": 203.63,
    "end": 205.957,
    "text": "소란 피우곤 하잖아"
  },
  {
    "start": 205.957,
    "end": 211.004,
    "text": "아빠가 돌아가시고서<br>쓸쓸해 하는 거겠지?"
  },
  {
    "start": 211.004,
    "end": 216.997,
    "text": "다들, 오빠한테<br>달라붙어 살게 돼버렸네"
  },
  {
    "start": 216.997,
    "end": 221.813,
    "text": "다녀와!"
  },
  {
    "start": 221.813,
    "end": 224.565,
    "text": "생활은 결코 편하진 않지만"
  },
  {
    "start": 224.565,
    "end": 226.788,
    "text": "참 행복하다"
  },
  {
    "start": 226.788,
    "end": 231.15,
    "text": "하지만 인생은<br>하늘처럼 변해가는 법이니깐"
  },
  {
    "start": 231.15,
    "end": 232.508,
    "text": "갖은 모습으로 변해가며..."
  },
  {
    "start": 232.508,
    "end": 234.675,
    "text": "움직여가지"
  },
  {
    "start": 234.675,
    "end": 237.299,
    "text": "평생 화창하기만<br>하지는 않을 뿐더러"
  },
  {
    "start": 237.299,
    "end": 240.748,
    "text": "평생 눈이 내리기만<br>하지도 않아"
  },
  {
    "start": 240.748,
    "end": 242.556,
    "text": "그리고"
  },
  {
    "start": 242.556,
    "end": 245.204,
    "text": "행복이 무너져내릴 때에는"
  },
  {
    "start": 245.204,
    "end": 247.364,
    "text": "언제나..."
  },
  {
    "start": 247.364,
    "end": 257.91700000000003,
    "text": "피의 냄새가 풍겨온다"
  },
  {
    "start": 257.91700000000003,
    "end": 260.02,
    "text": "어머, 탄지로 아니니!"
  },
  {
    "start": 260.02,
    "end": 263.035,
    "text": "이런 날에<br>산을 내려온 거야?"
  },
  {
    "start": 263.035,
    "end": 265.355,
    "text": "부지런히도 일하는구나!"
  },
  {
    "start": 265.355,
    "end": 267.099,
    "text": "감기 걸리겠다!"
  },
  {
    "start": 267.099,
    "end": 268.868,
    "text": "이 정도는<br>아무렇지도 않아"
  },
  {
    "start": 268.868,
    "end": 271.517,
    "text": "숯은 좀 어때?<br>부족하진 않아?"
  },
  {
    "start": 271.517,
    "end": 274.436,
    "text": "어이, 탄지로!"
  },
  {
    "start": 274.436,
    "end": 276.429,
    "text": "숯 좀 팔아다오!"
  },
  {
    "start": 276.429,
    "end": 280.075,
    "text": "요전에는<br>장지문 바꿔달아줘서 고마웠다~"
  },
  {
    "start": 280.075,
    "end": 285.964,
    "text": "우리 집도 숯 좀 팔아주렴!"
  },
  {
    "start": 285.964,
    "end": 287.884,
    "text": "탄지로~!"
  },
  {
    "start": 287.884,
    "end": 290.373,
    "text": "마침 잘 됐다!"
  },
  {
    "start": 290.373,
    "end": 293.28499999999997,
    "text": "접시 깬 범인<br>취급 받고 있다고, 내가~"
  },
  {
    "start": 293.28499999999997,
    "end": 295.068,
    "text": "좀 살려주라!"
  },
  {
    "start": 295.068,
    "end": 300.732,
    "text": "냄새 좀 맡아줘!"
  },
  {
    "start": 300.732,
    "end": 302.772,
    "text": "고양이 냄새가 나는데?"
  },
  {
    "start": 302.772,
    "end": 304.292,
    "text": "거 보라니까!!"
  },
  {
    "start": 304.292,
    "end": 306.093,
    "text": "어머, 고양이였니?"
  },
  {
    "start": 306.093,
    "end": 308.412,
    "text": "내가 아니라고 했잖아!!"
  },
  {
    "start": 308.412,
    "end": 309.772,
    "text": "아, 탄지로구만"
  },
  {
    "start": 309.772,
    "end": 317.852,
    "text": "잠깐 짐 옮기는 걸<br>도와주면 안 되겠냐?"
  },
  {
    "start": 317.852,
    "end": 320.588,
    "text": "많이 늦어버렸네~"
  },
  {
    "start": 320.588,
    "end": 321.653,
    "text": "그래도"
  },
  {
    "start": 321.653,
    "end": 324.812,
    "text": "전부 팔려서 다행이야"
  },
  {
    "start": 324.812,
    "end": 327.973,
    "text": "이놈아, 탄지로!"
  },
  {
    "start": 327.973,
    "end": 330.58,
    "text": "너, 산으로 돌아갈 셈이냐"
  },
  {
    "start": 330.58,
    "end": 332.589,
    "text": "위험하니 그만둬라"
  },
  {
    "start": 332.589,
    "end": 335.964,
    "text": "나는 냄새를 잘 맡으니까 괜찮아"
  },
  {
    "start": 335.964,
    "end": 337.924,
    "text": "우리 집에서 재워주마"
  },
  {
    "start": 337.924,
    "end": 341.077,
    "text": "와라, 돌아와"
  },
  {
    "start": 341.077,
    "end": 342.069,
    "text": "하지만..."
  },
  {
    "start": 342.069,
    "end": 344.65999999999997,
    "text": "잔말 말고 와라!"
  },
  {
    "start": 344.65999999999997,
    "end": 360.381,
    "text": "오니[鬼]가 나올 거다"
  },
  {
    "start": 360.381,
    "end": 366.509,
    "text": "잘 먹었습니다!"
  },
  {
    "start": 366.509,
    "end": 369.18,
    "text": "있잖아, 사부로 아저씨..."
  },
  {
    "start": 369.18,
    "end": 372.021,
    "text": "오니란 건 어떤 느낌이야?"
  },
  {
    "start": 372.021,
    "end": 378.74,
    "text": "예로부터 사람 잡아먹는 오니는<br>해가 지면 어슬렁대기 시작한댔지"
  },
  {
    "start": 378.74,
    "end": 379.821,
    "text": "그러니"
  },
  {
    "start": 379.821,
    "end": 382.78,
    "text": "밤에는 쏘다니면 못 쓴다"
  },
  {
    "start": 382.78,
    "end": 384.148,
    "text": "다 먹었으면 자라"
  },
  {
    "start": 384.148,
    "end": 390.972,
    "text": "내일 일찍 일어나<br>돌아가면 될 것 아니냐"
  },
  {
    "start": 390.972,
    "end": 392.348,
    "text": "오니는..."
  },
  {
    "start": 392.348,
    "end": 396.012,
    "text": "집 안에는<br>안 들어오는 거야?"
  },
  {
    "start": 396.012,
    "end": 397.28499999999997,
    "text": "아니"
  },
  {
    "start": 397.28499999999997,
    "end": 402.179,
    "text": "들어오지"
  },
  {
    "start": 402.179,
    "end": 403.444,
    "text": "그럼..."
  },
  {
    "start": 403.444,
    "end": 408.596,
    "text": "다들 오니한테<br>잡아먹혀버릴 거 아냐"
  },
  {
    "start": 408.596,
    "end": 412.692,
    "text": "그러니 오니 사냥꾼님들께서<br>오니를 베어주시는 것 아니겠냐"
  },
  {
    "start": 412.692,
    "end": 416.364,
    "text": "예로부터..."
  },
  {
    "start": 416.364,
    "end": 418.165,
    "text": "불 끌란다"
  },
  {
    "start": 418.165,
    "end": 422.564,
    "text": "이만 자거라"
  },
  {
    "start": 422.564,
    "end": 424.284,
    "text": "사부로 아저씨..."
  },
  {
    "start": 424.284,
    "end": 426.972,
    "text": "가족들을 여의고<br>홀로 살고 계시니까"
  },
  {
    "start": 426.972,
    "end": 429.428,
    "text": "쓸쓸한 거겠지"
  },
  {
    "start": 429.428,
    "end": 432.444,
    "text": "다음에 남동생들 데리고<br>놀러올 테니까"
  },
  {
    "start": 432.444,
    "end": 433.82,
    "text": "무서워 하지 않아도..."
  },
  {
    "start": 433.82,
    "end": 435.404,
    "text": "오니같은 건 없다구"
  },
  {
    "start": 435.404,
    "end": 437.515,
    "text": "괜찮아"
  },
  {
    "start": 437.515,
    "end": 440.068,
    "text": "그래도, 그러고 보니..."
  },
  {
    "start": 440.068,
    "end": 442.316,
    "text": "우리 할머니께서도<br>돌아가시기 전에..."
  },
  {
    "start": 442.316,
    "end": 449.829,
    "text": "비슷한 소리를 하셨지?"
  },
  {
    "start": 449.829,
    "end": 451.684,
    "text": "조심히 들어가라"
  },
  {
    "start": 451.684,
    "end": 461.484,
    "text": "응"
  },
  {
    "start": 461.484,
    "end": 464.412,
    "text": "행복이 무너져내릴 때에는"
  },
  {
    "start": 464.412,
    "end": 472.86,
    "text": "언제나…"
  },
  {
    "start": 472.86,
    "end": 497.626,
    "text": "피의 냄새...!"
  },
  {
    "start": 497.626,
    "end": 499.435,
    "text": "네즈코!!"
  },
  {
    "start": 499.435,
    "end": 500.603,
    "text": "왜 그래!"
  },
  {
    "start": 500.603,
    "end": 502.634,
    "text": "왜 이러고 있는데!!"
  },
  {
    "start": 502.634,
    "end": 510.203,
    "text": "무슨 일이 있었어!?"
  },
  {
    "start": 510.203,
    "end": 518.7860000000001,
    "text": "엄마...?"
  },
  {
    "start": 518.7860000000001,
    "end": 520.187,
    "text": "엄마..."
  },
  {
    "start": 520.187,
    "end": 522.082,
    "text": "하나코..."
  },
  {
    "start": 522.082,
    "end": 523.761,
    "text": "타케오..."
  },
  {
    "start": 523.761,
    "end": 525.683,
    "text": "시게루..."
  },
  {
    "start": 525.683,
    "end": 527.05,
    "text": "네즈코...!"
  },
  {
    "start": 527.05,
    "end": 536.618,
    "text": "로쿠타..."
  },
  {
    "start": 536.618,
    "end": 540.042,
    "text": "네즈코만은 아직<br>온기가 남아 있어!"
  },
  {
    "start": 540.042,
    "end": 543.074,
    "text": "의사한테 보여주면<br>살 수 있을지도 몰라!"
  },
  {
    "start": 543.074,
    "end": 546.498,
    "text": "어쩌다 이렇게 된 거지?"
  },
  {
    "start": 546.498,
    "end": 547.59,
    "text": "곰인가?"
  },
  {
    "start": 547.59,
    "end": 556.414,
    "text": "동면에 들어가지 못한<br>곰이 나온 걸까?"
  },
  {
    "start": 556.414,
    "end": 558.311,
    "text": "숨 쉬기가 괴로워...!"
  },
  {
    "start": 558.311,
    "end": 561.766,
    "text": "얼어붙은 공기 때문에<br>폐가 아파와!"
  },
  {
    "start": 561.766,
    "end": 563.533,
    "text": "앞으로 나아가란 말야!"
  },
  {
    "start": 563.533,
    "end": 566.59,
    "text": "좀 더 빨리 다리를 움직여!"
  },
  {
    "start": 566.59,
    "end": 569.03,
    "text": "아직 마을까지는<br>거리가 멀단 말야..."
  },
  {
    "start": 569.03,
    "end": 571.207,
    "text": "서둘러!"
  },
  {
    "start": 571.207,
    "end": 575.446,
    "text": "죽게 놔두지 않을 테니까..."
  },
  {
    "start": 575.446,
    "end": 577.862,
    "text": "꼭 구해줄게!"
  },
  {
    "start": 577.862,
    "end": 588.487,
    "text": "오빠가 구해줄게!!"
  },
  {
    "start": 588.487,
    "end": 598.1659999999999,
    "text": "아차!"
  },
  {
    "start": 598.1659999999999,
    "end": 600.103,
    "text": "살았..다..."
  },
  {
    "start": 600.103,
    "end": 602.021,
    "text": "눈 덕분에!"
  },
  {
    "start": 602.021,
    "end": 605.871,
    "text": "미끄러진 것도<br>눈 때문이긴 했지만..."
  },
  {
    "start": 605.871,
    "end": 613.373,
    "text": "네즈코..."
  },
  {
    "start": 613.373,
    "end": 614.478,
    "text": "네즈코!"
  },
  {
    "start": 614.478,
    "end": 616.968,
    "text": "괜찮니?!"
  },
  {
    "start": 616.968,
    "end": 618.439,
    "text": "걷지 않아도 돼!"
  },
  {
    "start": 618.439,
    "end": 621.638,
    "text": "내가 마을까지<br>업어다 줄 테니까!"
  },
  {
    "start": 621.638,
    "end": 631.909,
    "text": "네즈코!"
  },
  {
    "start": 631.909,
    "end": 634.883,
    "text": "이..이건?!"
  },
  {
    "start": 634.883,
    "end": 637.371,
    "text": "「오니」다!"
  },
  {
    "start": 637.371,
    "end": 641.78,
    "text": "사부로 아저씨가 하신 말씀이,<br>문득 지금 떠올랐다"
  },
  {
    "start": 641.78,
    "end": 644.212,
    "text": "네즈코가<br>사람 잡아먹는 오니?"
  },
  {
    "start": 644.212,
    "end": 645.197,
    "text": "아냐, 그렇지 않아!"
  },
  {
    "start": 645.197,
    "end": 646.643,
    "text": "네즈코는 인간이야!"
  },
  {
    "start": 646.643,
    "end": 648.867,
    "text": "태어났을 때부터!"
  },
  {
    "start": 648.867,
    "end": 650.068,
    "text": "하지만..."
  },
  {
    "start": 650.068,
    "end": 653.767,
    "text": "냄새가<br>평소의 네즈코랑은 달라졌어..."
  },
  {
    "start": 653.767,
    "end": 656.351,
    "text": "하지만 그건<br>네즈코가 한 짓이 아니었어!"
  },
  {
    "start": 656.351,
    "end": 658.671,
    "text": "로쿠타를 감싸듯<br>쓰러져 있었는데다,"
  },
  {
    "start": 658.671,
    "end": 659.831,
    "text": "입이나 손에"
  },
  {
    "start": 659.831,
    "end": 662.279,
    "text": "피는 묻어 있지 않았어"
  },
  {
    "start": 662.279,
    "end": 663.951,
    "text": "그리고 또 하나..."
  },
  {
    "start": 663.951,
    "end": 670.663,
    "text": "또 다른 냄새가 하나 더―!"
  },
  {
    "start": 670.663,
    "end": 674.871,
    "text": "몸이 커졌어...!"
  },
  {
    "start": 674.871,
    "end": 677.8389999999999,
    "text": "힘도 강해져가고 있어..."
  },
  {
    "start": 677.8389999999999,
    "end": 680.799,
    "text": "내가 다른 집에서<br>발 뻗고 자고 있던 동안에..."
  },
  {
    "start": 680.799,
    "end": 684.03,
    "text": "다들, 그런 끔찍한 짓을 당했다니!"
  },
  {
    "start": 684.03,
    "end": 685.791,
    "text": "아팠지?"
  },
  {
    "start": 685.791,
    "end": 688.398,
    "text": "괴로웠지...?"
  },
  {
    "start": 688.398,
    "end": 692.735,
    "text": "구해주지 못해서 미안해..."
  },
  {
    "start": 692.735,
    "end": 695.606,
    "text": "하다못해 네즈코만큼은<br>어떻게든 해주고 싶어!"
  },
  {
    "start": 695.606,
    "end": 697.502,
    "text": "하지만 힘이 어마어마해...!"
  },
  {
    "start": 697.502,
    "end": 699.583,
    "text": "밀어낼 수가 없어!"
  },
  {
    "start": 699.583,
    "end": 700.942,
    "text": "네즈코...!"
  },
  {
    "start": 700.942,
    "end": 702.831,
    "text": "힘내, 네즈코!"
  },
  {
    "start": 702.831,
    "end": 704.19,
    "text": "견디는 거야!"
  },
  {
    "start": 704.19,
    "end": 707.238,
    "text": "힘내줘!!"
  },
  {
    "start": 707.238,
    "end": 709.063,
    "text": "오니같은 게 되면 안 돼!"
  },
  {
    "start": 709.063,
    "end": 710.863,
    "text": "정신 차리는 거야!"
  },
  {
    "start": 710.863,
    "end": 712.495,
    "text": "힘내!"
  },
  {
    "start": 712.495,
    "end": 746.395,
    "text": "힘내란 말야―!!"
  },
  {
    "start": 746.395,
    "end": 752.003,
    "text": "뭐야...?"
  },
  {
    "start": 752.003,
    "end": 757.811,
    "text": "누구지?"
  },
  {
    "start": 757.811,
    "end": 760.067,
    "text": "칼...!?"
  },
  {
    "start": 760.067,
    "end": 761.969,
    "text": "어째서 감쌌지?"
  },
  {
    "start": 761.969,
    "end": 763.288,
    "text": "여동생이야!"
  },
  {
    "start": 763.288,
    "end": 767.849,
    "text": "우리 여동생이란 말야!"
  },
  {
    "start": 767.849,
    "end": 772.976,
    "text": "네즈코!"
  },
  {
    "start": 772.976,
    "end": 790.969,
    "text": "'그것'이 여동생이란 말이냐?"
  },
  {
    "start": 790.969,
    "end": 791.818,
    "text": "네즈코...!"
  },
  {
    "start": 791.818,
    "end": 796.826,
    "text": "꼼짝 마라"
  },
  {
    "start": 796.826,
    "end": 799.857,
    "text": "내 사명은,<br>오니를 베는 것이다"
  },
  {
    "start": 799.857,
    "end": 803.65,
    "text": "물론, 네 여동생의 목도 떨군다"
  },
  {
    "start": 803.65,
    "end": 804.882,
    "text": "기다려줘!"
  },
  {
    "start": 804.882,
    "end": 807.793,
    "text": "네즈코는<br>아무도 죽이지 않았어!!"
  },
  {
    "start": 807.793,
    "end": 809.611,
    "text": "우리 집에는 또 하나..."
  },
  {
    "start": 809.611,
    "end": 812.642,
    "text": "맡아 본 적 없는<br>다른 누군가의 냄새가 났어!"
  },
  {
    "start": 812.642,
    "end": 813.849,
    "text": "모두를 죽인―!"
  },
  {
    "start": 813.849,
    "end": 815.05,
    "text": "모두를 죽인 건..."
  },
  {
    "start": 815.05,
    "end": 816.826,
    "text": "아마도 그녀석일 거야!"
  },
  {
    "start": 816.826,
    "end": 818.866,
    "text": "네즈코가 아니란 말야!"
  },
  {
    "start": 818.866,
    "end": 822.306,
    "text": "어쩌다 지금<br>그렇게 된 건지는 모르겠지만!"
  },
  {
    "start": 822.306,
    "end": 823.85,
    "text": "그래도!!"
  },
  {
    "start": 823.85,
    "end": 825.97,
    "text": "진상은 별 것 아니지"
  },
  {
    "start": 825.97,
    "end": 828.379,
    "text": "상처에<br>오니의 피를 뒤집어썼으니"
  },
  {
    "start": 828.379,
    "end": 830.858,
    "text": "오니가 되었다"
  },
  {
    "start": 830.858,
    "end": 834.306,
    "text": "사람 잡아먹는 오니는<br>그런 식으로 불어나지"
  },
  {
    "start": 834.306,
    "end": 837.139,
    "text": "네즈코는 사람을 잡아먹고<br>그러지 않아!!"
  },
  {
    "start": 837.139,
    "end": 839.123,
    "text": "잘도 그런 태평한 소리를..."
  },
  {
    "start": 839.123,
    "end": 843.164,
    "text": "막 방금 전에<br>스스로가 잡아먹힐 뻔 해놓고는"
  },
  {
    "start": 843.164,
    "end": 844.46,
    "text": "아니야!"
  },
  {
    "start": 844.46,
    "end": 847.379,
    "text": "나는 분명 알아보고 있을 거야!"
  },
  {
    "start": 847.379,
    "end": 849.732,
    "text": "내가 아무도<br>공격 못하게 막을게!"
  },
  {
    "start": 849.732,
    "end": 852.07,
    "text": "꼭 네즈코를<br>인간으로 되돌려놓겠어!"
  },
  {
    "start": 852.07,
    "end": 854.453,
    "text": "반드시 낫게 만들게요!"
  },
  {
    "start": 854.453,
    "end": 856.044,
    "text": "낫지 않는다"
  },
  {
    "start": 856.044,
    "end": 857.325,
    "text": "오니가 되어버린 이상"
  },
  {
    "start": 857.325,
    "end": 859.734,
    "text": "인간으로 돌아오는 일은 없다"
  },
  {
    "start": 859.734,
    "end": 860.845,
    "text": "찾아낼게!!"
  },
  {
    "start": 860.845,
    "end": 863.532,
    "text": "반드시 방법을 찾아낼 테니까!"
  },
  {
    "start": 863.532,
    "end": 865.718,
    "text": "제발 죽이지 말아줘!!"
  },
  {
    "start": 865.718,
    "end": 868.622,
    "text": "우리 가족을 죽인 녀석도<br>찾아낼 테니까!"
  },
  {
    "start": 868.622,
    "end": 871.209,
    "text": "내가 전부<br>말끔하게 해결할 테니까!"
  },
  {
    "start": 871.209,
    "end": 872.777,
    "text": "그러니까!"
  },
  {
    "start": 872.777,
    "end": 874.337,
    "text": "그러니까아아!!"
  },
  {
    "start": 874.337,
    "end": 876.553,
    "text": "제발 하지 마아아!!"
  },
  {
    "start": 876.553,
    "end": 878.194,
    "text": "이제 이 이상..."
  },
  {
    "start": 878.194,
    "end": 881.762,
    "text": "나한테서 빼앗아가는 건―"
  },
  {
    "start": 881.762,
    "end": 884.249,
    "text": "하지 말아주세요..."
  },
  {
    "start": 884.249,
    "end": 885.437,
    "text": "제발..."
  },
  {
    "start": 885.437,
    "end": 889.17,
    "text": "동생을 죽이지 말아주세요..."
  },
  {
    "start": 889.17,
    "end": 891.978,
    "text": "부탁드릴게요..."
  },
  {
    "start": 891.978,
    "end": 901.929,
    "text": "이렇게 부탁드릴게요...!"
  },
  {
    "start": 901.929,
    "end": 903.689,
    "text": "생사여탈권을!"
  },
  {
    "start": 903.689,
    "end": 906.754,
    "text": "타인이 쥐게 놔두지 마라!!"
  },
  {
    "start": 906.754,
    "end": 909.513,
    "text": "꼴사납게<br>웅크려 절하는 짓은 집어쳐!"
  },
  {
    "start": 909.513,
    "end": 911.498,
    "text": "그딴 게 통할 거였으면"
  },
  {
    "start": 911.498,
    "end": 914.258,
    "text": "네 가족은<br>살해당하지도 않았을 거다!"
  },
  {
    "start": 914.258,
    "end": 916.145,
    "text": "빼앗느냐,<br>빼앗기느냐 하는 때에!"
  },
  {
    "start": 916.145,
    "end": 917.859,
    "text": "주도권도 쥐지 못하는<br>약해빠진 놈이!"
  },
  {
    "start": 917.859,
    "end": 919.297,
    "text": "여동생을 낫게 하겠다고?"
  },
  {
    "start": 919.297,
    "end": 921.546,
    "text": "원수를 찾아내?!"
  },
  {
    "start": 921.546,
    "end": 923.209,
    "text": "가소롭기 짝이 없군!"
  },
  {
    "start": 923.209,
    "end": 924.402,
    "text": "약자에게는..."
  },
  {
    "start": 924.402,
    "end": 926.682,
    "text": "아무런 권리도, 선택지도 없다!"
  },
  {
    "start": 926.682,
    "end": 928.33,
    "text": "철저하게 힘으로!"
  },
  {
    "start": 928.33,
    "end": 930.697,
    "text": "강자에게 짓밟혀 굴복당할 뿐!"
  },
  {
    "start": 930.697,
    "end": 932.538,
    "text": "여동생을 낫게 할 방법은..."
  },
  {
    "start": 932.538,
    "end": 934.585,
    "text": "오니들이라면<br>알고 있을지도 모르지!"
  },
  {
    "start": 934.585,
    "end": 935.674,
    "text": "하지만!"
  },
  {
    "start": 935.674,
    "end": 936.521,
    "text": "오니 놈들이!"
  },
  {
    "start": 936.521,
    "end": 940.097,
    "text": "네놈의 의지나 소망을<br>존중해줄 거라 생각하지 말라고!"
  },
  {
    "start": 940.097,
    "end": 942.994,
    "text": "당연히, 나도<br>네놈을 존중하진 않을 거다!"
  },
  {
    "start": 942.994,
    "end": 944.465,
    "text": "그게 현실이지!"
  },
  {
    "start": 944.465,
    "end": 947.738,
    "text": "어째서 방금 전 너는<br>여동생을 감싸고 엎드린 거지?!"
  },
  {
    "start": 947.738,
    "end": 950.057,
    "text": "고작 그따위로<br>지키려 했던 거냐!!"
  },
  {
    "start": 950.057,
    "end": 952.241,
    "text": "어째서 도끼를<br>휘두르지 않았지?!"
  },
  {
    "start": 952.241,
    "end": 954.323,
    "text": "왜 나한테 등을 보인 거냐!"
  },
  {
    "start": 954.323,
    "end": 955.506,
    "text": "그 잘못된 판단으로!"
  },
  {
    "start": 955.506,
    "end": 957.345,
    "text": "이렇게 여동생을 빼앗겼지!"
  },
  {
    "start": 957.345,
    "end": 963.85,
    "text": "네놈까지 한번에!<br>여동생을 꿰뚫어버릴 수도 있었다고!"
  },
  {
    "start": 963.85,
    "end": 965.497,
    "text": "울지 마라..."
  },
  {
    "start": 965.497,
    "end": 967.305,
    "text": "절망하면 안 되지!"
  },
  {
    "start": 967.305,
    "end": 970.378,
    "text": "그딴 건 지금 할 짓이 아니야"
  },
  {
    "start": 970.378,
    "end": 973.579,
    "text": "네놈이 처절하게<br>좌절한 것은 알고 있다"
  },
  {
    "start": 973.579,
    "end": 975.203,
    "text": "가족을 살해당하고"
  },
  {
    "start": 975.203,
    "end": 976.915,
    "text": "여동생은 오니가 되었으니"
  },
  {
    "start": 976.915,
    "end": 978.851,
    "text": "필시 괴로울 테지"
  },
  {
    "start": 978.851,
    "end": 981.548,
    "text": "비명을 질러대고 싶겠지?"
  },
  {
    "start": 981.548,
    "end": 983.659,
    "text": "나도 '잘 알아'..."
  },
  {
    "start": 983.659,
    "end": 986.995,
    "text": "내가 한나절만<br>더 일찍 도착했었더라면"
  },
  {
    "start": 986.995,
    "end": 990.467,
    "text": "네 가족들은<br>죽지 않았을지도 모르니까"
  },
  {
    "start": 990.467,
    "end": 991.708,
    "text": "하지만..."
  },
  {
    "start": 991.708,
    "end": 995.067,
    "text": "시간을 되감아<br>되돌릴 방법 따윈 없다"
  },
  {
    "start": 995.067,
    "end": 996.691,
    "text": "성을 내라...!"
  },
  {
    "start": 996.691,
    "end": 999.355,
    "text": "'용서하지 못한다'는<br>강하고도 순수한 분노는"
  },
  {
    "start": 999.355,
    "end": 1003.4590000000001,
    "text": "팔다리를 움직이기 위한<br>흔들림없는 원동력이 되지!"
  },
  {
    "start": 1003.4590000000001,
    "end": 1005.692,
    "text": "그런 나약한 각오로는..."
  },
  {
    "start": 1005.692,
    "end": 1007.387,
    "text": "여동생을 지켜내는 것도"
  },
  {
    "start": 1007.387,
    "end": 1008.907,
    "text": "낫게 하는 것도"
  },
  {
    "start": 1008.907,
    "end": 1010.948,
    "text": "가족의 원수를 갚는 것도―!"
  },
  {
    "start": 1010.948,
    "end": 1011.827,
    "text": "할 수 없다!"
  },
  {
    "start": 1011.827,
    "end": 1014.995,
    "text": "하...!"
  },
  {
    "start": 1014.995,
    "end": 1031.257,
    "text": "하지 마!!"
  },
  {
    "start": 1031.257,
    "end": 1034.442,
    "text": "감정에 맡긴 단순한 공격..."
  },
  {
    "start": 1034.442,
    "end": 1050.3,
    "text": "어리석군!"
  },
  {
    "start": 1050.3,
    "end": 1060.681,
    "text": "도끼는 어디로 갔지?"
  },
  {
    "start": 1060.681,
    "end": 1063.985,
    "text": "나무 그늘에 숨기 직전..."
  },
  {
    "start": 1063.985,
    "end": 1065.984,
    "text": "이쪽으로 돌을 던져"
  },
  {
    "start": 1065.984,
    "end": 1067.225,
    "text": "그와 동시에..."
  },
  {
    "start": 1067.225,
    "end": 1070.2,
    "text": "위쪽으로 도끼를 던졌다?"
  },
  {
    "start": 1070.2,
    "end": 1072.6970000000001,
    "text": "맨손인 것을 들키지 않도록"
  },
  {
    "start": 1072.6970000000001,
    "end": 1076.593,
    "text": "휘두르려는 자세로<br>손 언저리를 감추고..."
  },
  {
    "start": 1076.593,
    "end": 1079.978,
    "text": "내게 이기지 못할 걸<br>알고 있었기 때문이다"
  },
  {
    "start": 1079.978,
    "end": 1082.145,
    "text": "자신이 베인 뒤에"
  },
  {
    "start": 1082.145,
    "end": 1085.128,
    "text": "나를 쓰러뜨리려 했다?!"
  },
  {
    "start": 1085.128,
    "end": 1091.409,
    "text": "이녀석은..."
  },
  {
    "start": 1091.409,
    "end": 1092.472,
    "text": "아차!"
  },
  {
    "start": 1092.472,
    "end": 1098.247,
    "text": "먹히고 말겠어!"
  },
  {
    "start": 1098.247,
    "end": 1103.159,
    "text": "<i>네즈코는..."
  },
  {
    "start": 1103.159,
    "end": 1107.038,
    "text": "<i>네즈코는 안 그래..."
  },
  {
    "start": 1107.038,
    "end": 1112.63,
    "text": "<i>사람을 잡아먹고<br>그러진 않아!"
  },
  {
    "start": 1112.63,
    "end": 1114.222,
    "text": "예전에..."
  },
  {
    "start": 1114.222,
    "end": 1115.871,
    "text": "같은 소리를 하며"
  },
  {
    "start": 1115.871,
    "end": 1118.758,
    "text": "오니에게<br>잡아먹힌 녀석이 있었다"
  },
  {
    "start": 1118.758,
    "end": 1121.1,
    "text": "\"굶주린 상태\"에 빠져든 오니는"
  },
  {
    "start": 1121.1,
    "end": 1124.484,
    "text": "부모든, 형제든<br>죽이고는 잡아먹는다"
  },
  {
    "start": 1124.484,
    "end": 1127.037,
    "text": "영양가가 높기 때문이지"
  },
  {
    "start": 1127.037,
    "end": 1131.324,
    "text": "지금껏 그런 광경을<br>산더미처럼 보아왔다"
  },
  {
    "start": 1131.324,
    "end": 1134.22,
    "text": "이 소녀는<br>상처까지 입었으며"
  },
  {
    "start": 1134.22,
    "end": 1135.7,
    "text": "그것을 치유하기 위해서"
  },
  {
    "start": 1135.7,
    "end": 1137.749,
    "text": "힘을 소비하고 있지"
  },
  {
    "start": 1137.749,
    "end": 1139.31,
    "text": "오니로 변모할 때에도"
  },
  {
    "start": 1139.31,
    "end": 1142.117,
    "text": "상당히 체력을 소비했을 테니"
  },
  {
    "start": 1142.117,
    "end": 1143.908,
    "text": "틀림없이 지금은..."
  },
  {
    "start": 1143.908,
    "end": 1146.7,
    "text": "격심하게 굶주린 상태겠지"
  },
  {
    "start": 1146.7,
    "end": 1148.484,
    "text": "한시라도 빨리..."
  },
  {
    "start": 1148.484,
    "end": 1151.741,
    "text": "인간의 피와 살을<br>탐하고 싶었을 것이거늘"
  },
  {
    "start": 1151.741,
    "end": 1153.621,
    "text": "지켜내려는듯한 동작..."
  },
  {
    "start": 1153.621,
    "end": 1158.549,
    "text": "내게 위협을 가했다"
  },
  {
    "start": 1158.549,
    "end": 1160.349,
    "text": "이녀석들은..."
  },
  {
    "start": 1160.349,
    "end": 1161.988,
    "text": "무언가가..."
  },
  {
    "start": 1161.988,
    "end": 1181.228,
    "text": "다른 걸지도 모르겠어―"
  },
  {
    "start": 1181.228,
    "end": 1183.838,
    "text": "<i>두고 가버려서 미안하구나..."
  },
  {
    "start": 1183.838,
    "end": 1186.213,
    "text": "<i>탄지로"
  },
  {
    "start": 1186.213,
    "end": 1199.964,
    "text": "<i>네즈코를 부탁할게?"
  },
  {
    "start": 1199.964,
    "end": 1204.435,
    "text": "일어났나?"
  },
  {
    "start": 1204.435,
    "end": 1206.948,
    "text": "안개산[사기리야마]의 기슭에 살고 있는"
  },
  {
    "start": 1206.948,
    "end": 1211.006,
    "text": "「우로코다키 사콘지」[鱗滝左近次]라는<br>노인을 찾아가 봐"
  },
  {
    "start": 1211.006,
    "end": 1215.23,
    "text": "「토미오카 기유」[冨岡 義勇]한테<br>소개받고 왔다고 해라"
  },
  {
    "start": 1215.23,
    "end": 1218.862,
    "text": "지금은 햇빛이 내려쬐지 않으니<br>괜찮은 모양이다만"
  },
  {
    "start": 1218.862,
    "end": 1238.919,
    "text": "동생을 태양 아래로<br>데리고 나가지 않는 게 좋을 거다"
  },
  {
    "start": 1238.919,
    "end": 1276.534,
    "text": "가자..."
  },
  {
    "start": 1276.534,
    "end": 1281.109,
    "text": "제1화 - 잔혹<br>"
  },
  {
    "start": 1281.109,
    "end": 1284.478,
    "text": "강해질 수 있을"
  },
  {
    "start": 1284.478,
    "end": 1287.614,
    "text": "이유를 깨달았어"
  },
  {
    "start": 1287.614,
    "end": 1291.094,
    "text": "나를 이끌고서"
  },
  {
    "start": 1291.094,
    "end": 1298.91,
    "text": "나아가줘"
  },
  {
    "start": 1298.91,
    "end": 1301.47,
    "text": "진흙투성이인"
  },
  {
    "start": 1301.47,
    "end": 1304.366,
    "text": "주마등을 노려보네"
  },
  {
    "start": 1304.366,
    "end": 1306.005,
    "text": "두려워 굳어버린 마음"
  },
  {
    "start": 1306.005,
    "end": 1308.43,
    "text": "떨리는 이 손은"
  },
  {
    "start": 1308.43,
    "end": 1311.093,
    "text": "붙잡고 싶은 게 있어"
  },
  {
    "start": 1311.093,
    "end": 1312.894,
    "text": "그것뿐이야"
  },
  {
    "start": 1312.894,
    "end": 1315.069,
    "text": "밤의 내음 속에"
  },
  {
    "start": 1315.069,
    "end": 1316.373,
    "text": "I'll spend all thirty nights"
  },
  {
    "start": 1316.373,
    "end": 1318.55,
    "text": "하늘을 노려보아도"
  },
  {
    "start": 1318.55,
    "end": 1319.982,
    "text": "Staring into the sky"
  },
  {
    "start": 1319.982,
    "end": 1322.325,
    "text": "변해갈 수 있는 것은"
  },
  {
    "start": 1322.325,
    "end": 1325.345,
    "text": "자기 자신뿐"
  },
  {
    "start": 1325.345,
    "end": 1327.329,
    "text": "그것뿐이야"
  },
  {
    "start": 1327.329,
    "end": 1330.626,
    "text": "강해질 수 있을"
  },
  {
    "start": 1330.626,
    "end": 1333.785,
    "text": "이유를 깨달았어"
  },
  {
    "start": 1333.785,
    "end": 1335.578,
    "text": "나를"
  },
  {
    "start": 1335.578,
    "end": 1337.281,
    "text": "이끌고서"
  },
  {
    "start": 1337.281,
    "end": 1340.21,
    "text": "나아가줘"
  },
  {
    "start": 1340.21,
    "end": 1341.53,
    "text": "아무리 애를 써도"
  },
  {
    "start": 1341.53,
    "end": 1343.009,
    "text": "지워내지 못할 꿈도"
  },
  {
    "start": 1343.009,
    "end": 1344.818,
    "text": "멈추지 못할 지금도"
  },
  {
    "start": 1344.818,
    "end": 1349.265,
    "text": "누군가를 위해 강해질 수만 있다면"
  },
  {
    "start": 1349.265,
    "end": 1350.818,
    "text": "몇번이라도"
  },
  {
    "start": 1350.818,
    "end": 1354.394,
    "text": "다시 일어나라"
  },
  {
    "start": 1354.394,
    "end": 1357.283,
    "text": "세상의 벽앞에 좌절하고"
  },
  {
    "start": 1357.283,
    "end": 1359.048,
    "text": "지켜내는 의미를 깨달았어"
  },
  {
    "start": 1359.048,
    "end": 1363.465,
    "text": "홍련의 꽃이여, 피어올라라"
  },
  {
    "start": 1363.465,
    "end": 1365.306,
    "text": "운명을"
  },
  {
    "start": 1365.306,
    "end": 1368.306,
    "text": "밝혀내다오"
  }
]